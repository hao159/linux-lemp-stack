write_info() {
    rm -f "${FILE_INFO}"
    touch "${FILE_INFO}"
    {
        echo "script_version=${SCRIPTS_VERSION}"
        echo "ssh_port=${SSH_PORT}"
        echo "admin_port=${RANDOM_ADMIN_PORT}"
        echo "admin_pwd=${ADMIN_TOOL_PWD}"
        echo "mysql_pwd=${sql_admin_pass}"
        echo "admin_email=${ADMIN_EMAIL}"
        echo "php1_release=yes"
        echo "php2_release=${PHP2_RELEASE}"
        echo "php1_version=${PHP_VERSION}"
        echo "php2_version=${PHP_VERSION_2}"
        echo "webserver=${WEBSERVER}"
        echo "lang=vi"
        echo "install_mode=${INSTALL_MODE}"
    } >>"${FILE_INFO}"

    touch /etc/hostvn.lock
    chmod 600 "${FILE_INFO}" /etc/hostvn.lock

    cat >"/var/hostvn/ipaddress" <<END
#!/bin/bash
IPADDRESS=${IPADDRESS}
END
}

open_port() {
    if [ "${INSTALL_MODE}" == "dev" ]; then
        # Internal server: never switch on a firewall that the admin left off,
        # only add our ports when one is already running.
        if ! fw_active; then
            return 0
        fi
    else
        fw_enable
    fi

    fw_allow_port "${SSH_PORT}"
    fw_allow_port 22
    fw_allow_port 80
    fw_allow_port 443
    fw_allow_port "${RANDOM_ADMIN_PORT}"
    fw_reload
}

