############################################
# Fail2ban
############################################
install_fail2ban() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        pkg_install fail2ban || return 1
        pkg_install_optional fail2ban-firewalld fail2ban-systemd
    else
        pkg_install fail2ban || return 1
        pkg_install_optional python3-systemd
    fi

    # The jail.conf shipped by the distribution is kept, only overrides are written.
    cat >"/etc/fail2ban/jail.d/defaults.conf" <<END
[DEFAULT]
ignoreip   = 127.0.0.1/8 ::1
findtime   = 600
bantime    = 86400
maxretry   = 5
destemail  = ${ADMIN_EMAIL}
sender     = ${ADMIN_EMAIL}
sendername = Fail2ban
END
    if [ "${WEBSERVER}" == "apache" ]; then
        cat >"/etc/fail2ban/jail.d/apache-auth.conf" <<END
[apache-auth]
enabled  = true
filter   = apache-auth
port     = ${RANDOM_ADMIN_PORT}
logpath  = ${AP_LOG_DIR}/*error*log
backend  = auto
maxretry = 5
bantime  = 86400
END
    else
        cat >"/etc/fail2ban/jail.d/nginx-http-auth.conf" <<END
[nginx-http-auth]
enabled  = true
filter   = nginx-http-auth
port     = ${RANDOM_ADMIN_PORT}
logpath  = /var/log/nginx/error.log
backend  = auto
maxretry = 5
bantime  = 86400
END
    fi
    cat >"/etc/fail2ban/jail.d/sshd.local" <<END
[sshd]
enabled  = true
filter   = sshd
port     = ${SSH_PORT}
backend  = systemd
maxretry = 5
