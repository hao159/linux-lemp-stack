# CrowdSec, AppSec and Telegram are optional, all of them can be added later from the menu.
option_security() {
    local prev_cs="${INSTALL_CROWDSEC}" prev_appsec="${INSTALL_APPSEC}"
    INSTALL_CROWDSEC="n"
    INSTALL_APPSEC="n"
    wz_step "CrowdSec & AppSec"
    echo "CrowdSec doc log web server/SSH va tu dong chan IP tan cong, IP scan (giam log ban)."
    echo "Khi cai CrowdSec, access log cua web server se duoc bat (co rotate)."
    if [ "${WEBSERVER}" != "apache" ]; then
        echo "AppSec la WAF cua CrowdSec, chan request doc hai truoc khi toi website."
    fi
    echo "Bo qua thi van bat duoc sau trong menu hostvn."
    echo ""
    if ask_yes_no "Ban co muon cai dat CrowdSec khong ?" "$(yn_default "${prev_cs}")"; then
        INSTALL_CROWDSEC="y"
        # AppSec runs in the Nginx Lua bouncer, there is none for Apache
        if [ "${WEBSERVER}" != "apache" ] &&
            ask_yes_no "Ban co muon bat AppSec (WAF) khong ?" "$(yn_default "${prev_appsec}" y)"; then
            INSTALL_APPSEC="y"
        fi
        echo ""
        cs_prompt_rotate_days
    fi
}

option_telegram() {
    local prev="${SETUP_TELEGRAM}"
    SETUP_TELEGRAM="n"
    wz_step "Thong bao Telegram"
    echo "Thong bao qua Telegram: dang nhap SSH, dich vu ngung hoat dong, day o cung, IP bi CrowdSec chan."
    echo "Bo qua thi van cau hinh duoc sau trong menu hostvn."
    echo ""
    if [ "${prev}" == "y" ] && [ -n "${TELEGRAM_TOKEN}" ]; then
        if ask_yes_no "Giu cau hinh Telegram da nhap (Chat ID ${TELEGRAM_ID}) ?" "y"; then
            SETUP_TELEGRAM="y"
            return 0
        fi
    fi
    if ask_yes_no "Ban co muon cau hinh thong bao Telegram khong ?" "n"; then
        # The token must not end up in the installation trace
        set +x
        if tg_prompt; then
            SETUP_TELEGRAM="y"
        else
            echo "Bo qua Telegram. Ban co the cau hinh sau trong menu hostvn."
        fi
        set -x
        sleep 2
    fi
}

setup_security() {
    CROWDSEC_STATUS="Khong cai dat"
    APPSEC_STATUS="Khong bat"
    ACCESS_LOG_STATUS="Tat"
    [ "${INSTALL_CROWDSEC}" == "y" ] || return 0

    if ! cs_install "${CS_ROTATE_DAYS}"; then
        CROWDSEC_STATUS="Cai dat that bai (cai lai trong menu hostvn)"
        return 0
    fi
    CROWDSEC_STATUS="Da cai dat"
    if cs_access_log_enabled; then
        ACCESS_LOG_STATUS="${CS_ACCESS_LOG} (giu ${CS_ROTATE_DAYS} ngay)"
    fi

    # The admin must never be banned from the server he is installing
    SSH_CLIENT_IP=$(echo "${SSH_CLIENT}" | awk '{print $1}')
    if [ -n "${SSH_CLIENT_IP}" ] && cs_allow_ip "${SSH_CLIENT_IP}"; then
        CROWDSEC_STATUS="Da cai dat (IP tin cay: ${SSH_CLIENT_IP})"
    fi

    if [ "${INSTALL_APPSEC}" == "y" ]; then
        if cs_appsec_enable; then
            APPSEC_STATUS="Da bat"
        else
            APPSEC_STATUS="Bat that bai (bat lai trong menu hostvn)"
        fi
    fi
}

setup_telegram() {
    TELEGRAM_STATUS="Khong cau hinh"
    [ "${SETUP_TELEGRAM}" == "y" ] || return 0

    set +x
    tg_save "${TELEGRAM_ID}" "${TELEGRAM_TOKEN}" "${TELEGRAM_THREAD}"
    tg_ssh_enable
    tg_service_enable
    tg_disk_enable
    TELEGRAM_STATUS="SSH login, dich vu, o cung"
    if cs_installed && cs_telegram_enable "${TELEGRAM_ID}" "${TELEGRAM_TOKEN}" "${TELEGRAM_THREAD}"; then
        TELEGRAM_STATUS="${TELEGRAM_STATUS}, IP bi CrowdSec chan"
    fi
    set -x
}

# Index (1-based) of a version in a list, 1 when absent
php_index_of() {
    local want="$1" i=1 v
    shift
    for v in "$@"; do
        [ "${v//php/}" == "${want}" ] && echo "${i}" && return 0
        i=$((i + 1))
    done
    echo 1
}

select_php_ver() {
    local labels=() others=() v def
    for v in "${PHP_LIST[@]}"; do
        labels+=("PHP ${v//php/}")
    done
    # Default: previous answer, otherwise the second entry (newest is often too fresh for plugins)
    if [ -n "${PHP_VERSION}" ]; then
        def=$(php_index_of "${PHP_VERSION}" "${PHP_LIST[@]}")
    else
        def=$(( ${#PHP_LIST[@]} > 1 ? 2 : 1 ))
    fi
    wz_step "Phien ban PHP"
    echo "Phien ban PHP chinh (PHP 1) dung cho cac website moi."
    echo ""
    wz_choose "${def}" "${labels[@]}"
    PHP_VERSION="${PHP_LIST[$((WZ_CHOICE - 1))]//php/}"

    echo ""
    MULTI_PHP="n"
    if ask_yes_no "Cai them phien ban PHP thu hai (chay song song, doi theo tung website) ?" \
        "$(yn_default "${WZ_MULTI_PHP_DEF}")"; then
        MULTI_PHP="y"
    fi
    WZ_MULTI_PHP_DEF="${MULTI_PHP}"

    if [ "${MULTI_PHP}" == "y" ]; then
        labels=()
        for v in "${PHP_LIST[@]}"; do
            [ "${v//php/}" == "${PHP_VERSION}" ] && continue
            others+=("${v}")
            labels+=("PHP ${v//php/}")
        done
        def=1
        [ -n "${PHP_VERSION_2}" ] && def=$(php_index_of "${PHP_VERSION_2}" "${others[@]}")
        echo ""
        echo "Phien ban PHP thu hai (PHP 2):"
        wz_choose "${def}" "${labels[@]}"
        PHP_VERSION_2="${others[$((WZ_CHOICE - 1))]//php/}"
    else
        PHP_VERSION_2=""
    fi
}

php_set_paths() {
    PHP1_CONFIG_PATH="/etc/php/${PHP_VERSION}/fpm"
    PHP1_INI_PATH="${PHP1_CONFIG_PATH}/conf.d"
    PHP1_POOL_PATH="${PHP1_CONFIG_PATH}/pool.d"
    PHP1_CLI_PATH="/etc/php/${PHP_VERSION}/cli/conf.d"
    if [ "${MULTI_PHP}" == "y" ]; then
        PHP2_CONFIG_PATH="/etc/php/${PHP_VERSION_2}/fpm"
        PHP2_INI_PATH="${PHP2_CONFIG_PATH}/conf.d"
        PHP2_POOL_PATH="${PHP2_CONFIG_PATH}/pool.d"
        PHP2_CLI_PATH="/etc/php/${PHP_VERSION_2}/cli/conf.d"
    fi
}

# Last screen of the wizard: everything chosen, confirm before touching the server
wz_summary() {
    local ram_mb=$((RAM_TOTAL / 1024)) yn
    clear
    printf "========================================================\n"
    printf "  Tom tat lua chon\n"
    printf "========================================================\n"
    echo ""
    printf "  %-22s: %s %s (RAM %s MB, %s CPU)\n" "He dieu hanh" "${OS_ID}" "${OS_VERSION_ID}" "${ram_mb}" "${CPU_CORES}"
    if [ "${INSTALL_MODE}" == "dev" ]; then
        printf "  %-22s: %s\n" "Che do" "Dev server noi bo (IP:PORT)"
    else
        printf "  %-22s: %s\n" "Che do" "Production (VPS public)"
    fi
    printf "  %-22s: %s\n" "Email" "${ADMIN_EMAIL}"
    printf "  %-22s: %s\n" "IP server" "${IPADDRESS}"
    printf "  %-22s: %s\n" "Port SSH" "${SSH_PORT}"
    printf "  %-22s: %s\n" "Web server" "${WEBSERVER^}"
    if [ "${MULTI_PHP}" == "y" ]; then
        printf "  %-22s: %s\n" "PHP" "${PHP_VERSION} (PHP 1), ${PHP_VERSION_2} (PHP 2)"
    else
        printf "  %-22s: %s\n" "PHP" "${PHP_VERSION}"
    fi
    printf "  %-22s: %s\n" "MariaDB" "${MARIADB_VERSION}"
    if [ "${SWAP_SIZE:-0}" -gt 0 ] 2>/dev/null; then
        printf "  %-22s: %s\n" "Swap" "Tao moi ${SWAP_SIZE}G"
    fi
    if [ "${INSTALL_CROWDSEC}" == "y" ]; then
        yn="Co (giu access log ${CS_ROTATE_DAYS} ngay)"
        [ "${INSTALL_APPSEC}" == "y" ] && yn="${yn}, bat AppSec (WAF)"
    else
        yn="Khong"
    fi
    printf "  %-22s: %s\n" "CrowdSec" "${yn}"
    if [ "${SETUP_TELEGRAM}" == "y" ]; then
        printf "  %-22s: %s\n" "Telegram" "Co (Chat ID ${TELEGRAM_ID})"
    else
        printf "  %-22s: %s\n" "Telegram" "Khong"
    fi
    echo ""
    if [ "${INSTALL_MODE}" != "dev" ]; then
        printf "${RED}%s${NC}\n" "  Server se tu khoi dong lai sau khi cai dat xong."
        echo ""
    fi
    wz_choose 1 "Bat dau cai dat" "Chon lai tu dau" "Huy cai dat"
}

# All questions are asked up front, the installation then runs without interaction
run_wizard() {
    while true; do
        WZ_STEP=0
        wz_mode
        set_email
        input_ip
        option_change_ssh_port
        select_php_ver
        option_webserver
        wz_swap
        option_security
        option_telegram
        wz_summary
        case "${WZ_CHOICE}" in
        1) break ;;
        3)
            echo "Da huy cai dat. Chua co thay doi nao tren server."
            exit 0
            ;;
        esac
    done
    php_set_paths
}

############################################
# Install LEMP Stack
############################################
install_nginx() {
    nginx_build "$(get_version nginx_version)" || fatal "Build Nginx that bai."
    nginx_install_service
    cd_dir "${DIR}"
}

# Apache instead of Nginx. The account "nginx" and the folders under /etc/nginx and
# /usr/share/nginx are kept: the PHP pools, the certificates and the admin tools use them.
install_apache() {
    os_add_nginx_user
    mkdir -p /etc/nginx/ssl "${DEFAULT_DIR_WEB}" "${DEFAULT_DIR_TOOL}" /var/log/nginx
    chown -R nginx:nginx "${DEFAULT_DIR_WEB}"
}

setup_apache() {
    ADMIN_PORT_NEW="${RANDOM_ADMIN_PORT}"
    if ! ap_install standalone; then
        printf "${RED}%s${NC}\n" "Apache khong khoi dong duoc, vui long kiem tra cau hinh (apache2ctl -t / httpd -t)."
    fi
}

install_mariadb() {
    mariadb_install "${MARIADB_VERSION}" || fatal "Cai dat MariaDB that bai."
}

install_php() {
    php_install "${PHP_VERSION}" || fatal "Cai dat PHP ${PHP_VERSION} that bai."
