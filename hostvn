############################################
# Wizard helpers
############################################
WZ_STEP=0

# wz_step <title> : new screen of the wizard
wz_step() {
    WZ_STEP=$((WZ_STEP + 1))
    clear
    printf "========================================================\n"
    printf "  Cai dat LEMP Stack - Buoc %s: %s\n" "${WZ_STEP}" "$1"
    printf "========================================================\n"
    echo ""
}

# wz_choose <default> <option>... : prints a numbered list, sets WZ_CHOICE (1..n)
wz_choose() {
    local def="$1" answer i=1 opt n
    shift
    n=$#
    for opt in "$@"; do
        if [ "${i}" == "${def}" ]; then
            printf "  %s. %s  (mac dinh)\n" "${i}" "${opt}"
        else
            printf "  %s. %s\n" "${i}" "${opt}"
        fi
        i=$((i + 1))
    done
    echo ""
    while true; do
        read -r -p "Nhap vao lua chon cua ban [1-${n}] (Enter = ${def}): " answer
        answer="${answer:-${def}}"
        if [[ "${answer}" =~ ^[0-9]+$ ]] && [ "${answer}" -ge 1 ] && [ "${answer}" -le "${n}" ]; then
            WZ_CHOICE="${answer}"
            return 0
        fi
        printf "${RED}%s${NC}\n" "Lua chon khong chinh xac, vui long nhap lai."
    done
}

# ask_yes_no <question> [y|n] : returns 0 for Yes, Enter takes the default when given
ask_yes_no() {
    local answer hint="(y/n)"
    case "$2" in
    y) hint="(Y/n)" ;;
    n) hint="(y/N)" ;;
    esac
    while true; do
        read -r -p "$1 ${hint} " answer
        answer="${answer:-$2}"
        case "${answer}" in
        y | Y) return 0 ;;
        n | N) return 1 ;;
        *) printf "${RED}%s${NC}\n" "Lua chon khong chinh xac, vui long nhap lai." ;;
        esac
    done
}

# Remember the previous answer as the default when the wizard is restarted
yn_default() {
    [ "$1" == "y" ] && echo "y" || echo "${2:-n}"
}

wz_mode() {
    local def=1
    [ "${INSTALL_MODE}" == "dev" ] && def=2
    wz_step "Che do cai dat"
    echo "Production : VPS public, website chay bang ten mien, co SSL Let's Encrypt, Fail2ban,"
    echo "             toi uu kernel, co the doi port SSH, tu reboot sau khi cai."
    echo "Dev        : server noi bo, website chay bang IP:PORT, PHP hien loi, khong doi port SSH,"
    echo "             khong toi uu kernel, khong tu bat firewall, khong tu reboot."
    echo ""
    wz_choose "${def}" "Production (VPS public)" "Dev server noi bo (IP:PORT)"
    if [ "${WZ_CHOICE}" == "2" ]; then
        INSTALL_MODE="dev"
    else
        INSTALL_MODE="prod"
    fi
    echo "Dang xac dinh dia chi IP..."
    apply_install_mode
}

# Only touch the resolver when name resolution really does not work
check_dns_server() {
    if ! getent hosts github.com >/dev/null 2>&1; then
        cp /etc/resolv.conf /etc/resolv.conf."$(date +%Y-%m-%d)" 2>/dev/null
        echo "nameserver 1.1.1.1" >>/etc/resolv.conf
    fi
}

# Wizard: SWAP_SIZE in GB, 0 = no swap
wz_swap() {
    local size def="${SWAP_SIZE:-2}"
    SWAP_SIZE=0
    [ -n "$(swapon --show --noheadings 2>/dev/null)" ] && return 0

    wz_step "Swap"
    echo "VPS chua co swap. Swap giup tranh loi het RAM khi build Nginx / chay MariaDB."
    echo ""
    [ "${def}" == "0" ] && def=2
    if ask_yes_no "Ban co muon tao swap khong ?" "y"; then
        while true; do
            read -r -p "Dung luong swap (GB) (Enter = ${def}): " size
            size="${size:-${def}}"
            if [[ "${size}" =~ ^[0-9]+$ ]] && [ "${size}" -ge 1 ] && [ "${size}" -le 64 ]; then
                SWAP_SIZE="${size}"
                break
            fi
            printf "${RED}%s${NC}\n" "Gia tri ban nhap khong dung (1-64). Vui long nhap lai."
        done
    fi
}

create_swap() {
    [ "${SWAP_SIZE:-0}" -gt 0 ] 2>/dev/null || return 0
    [ -n "$(swapon --show --noheadings 2>/dev/null)" ] && return 0
    fallocate -l "${SWAP_SIZE}"G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=$((SWAP_SIZE * 1024))
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile none swap sw 0 0' >>/etc/fstab
}

set_timezone() {
    timedatectl set-timezone Asia/Ho_Chi_Minh 2>/dev/null ||
