}

############################################
# SFTP
############################################

setup_sftp(){
    cp /etc/ssh/sshd_config /etc/ssh/sshd_config."$(date +%Y-%m-%d)"

    check_sshd_config=$(grep -w "filetransfer" "/etc/ssh/sshd_config")
    if [ -z "${check_sshd_config}" ]; then
        cat >> "/etc/ssh/sshd_config" << END

# filetransfer: SFTP only users, locked inside their home folder
Match Group filetransfer
    ChrootDirectory %h
    X11Forwarding no
    AllowTcpForwarding no
    AllowAgentForwarding no
    PermitTunnel no
    ForceCommand internal-sftp
    PasswordAuthentication yes
END
    fi

    os_add_group filetransfer

    if sshd -t; then
        systemctl reload sshd 2>/dev/null || systemctl reload ssh 2>/dev/null
    fi
}

# Create menu
############################################
add_menu() {
    rm -rf "${BASH_DIR}"/menu /usr/bin/hostvn
    cp -r "${LEMP_SRC_DIR}"/menu "${BASH_DIR}"/menu
    cp "${LEMP_SRC_DIR}"/version "${BASH_DIR}"/version
    find "${BASH_DIR}"/menu -name ".DS_Store" -delete
    find "${BASH_DIR}"/menu -type f ! -name "*.conf" ! -name "*.html" -exec sed -i 's/\r$//' {} +
    mkdir -p "${BASH_DIR}"/users
    mkdir -p /var/log/hostvn
    mkdir -p /var/hostvn/wpcron
    cd_dir "${BASH_DIR}"
    chmod 711 menu users wpcron
    find "${BASH_DIR}"/menu -type f -exec chmod +x {} +

    cp "${BASH_DIR}"/menu/hostvn /usr/bin/hostvn && chmod +x /usr/bin/hostvn
    cd_dir "${DIR}"
}

