option_change_ssh_port() {
    local current
    current=$(grep -E "^Port " /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -n1)
    current=${current:-22}
    prompt_ssh="n"
    SSH_PORT="${current}"
    # Dev servers keep their SSH port
    [ "${INSTALL_MODE}" == "dev" ] && return 0

    wz_step "Port SSH"
    echo "Port SSH hien tai: ${current}"
    echo "Doi sang port 8282 giup giam bot do mat khau SSH."
    echo "Luu y: Voi Google Cloud, Alibaba Cloud, AWS can mo port 8282 trong tab Firewall cua nha cung cap."
    echo ""
    wz_choose "${WZ_SSH_DEF:-2}" "Doi port SSH sang 8282" "Giu nguyen port ${current}"
    WZ_SSH_DEF="${WZ_CHOICE}"
    if [ "${WZ_CHOICE}" == "1" ]; then
        prompt_ssh="y"
        SSH_PORT="8282"
    fi
}

# Nginx (default) or Apache
