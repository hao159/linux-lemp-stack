#!/bin/bash

######################################################################
#      Auto Install & Optimize LEMP Stack                            #
#      Ubuntu / Debian / AlmaLinux / Rocky / Oracle Linux / CentOS   #
#                                                                    #
#                Author: Sanvv - HOSTVN Technical                    #
#                  Website: https://hostvn.vn                        #
#                                                                    #
#              Please do not remove copyright. Thank!                #
#  Please do not copy under any circumstance for commercial reason!  #
######################################################################

# Usage:
#   ./install            Production server (public VPS)
#   ./install --dev      Internal dev server: sites are served on IP:PORT,
#                        no SSH port change, no kernel tweak, no reboot.
#   ./install --force    Skip the "service already installed" check.

REPO_SLUG="${REPO_SLUG:-hao159/linux-lemp-stack}"
REPO_BRANCH="${REPO_BRANCH:-master}"
SRC_DIR="/opt/lemp-stack-src"

RED='\033[0;31m'
NC='\033[0m'

INSTALL_MODE="prod"
FORCE="no"
for arg in "$@"; do
    case "${arg}" in
    --dev) INSTALL_MODE="dev" ;;
    --force) FORCE="yes" ;;
    -h | --help)
        sed -n '14,18p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    esac
done

die() {
    printf "${RED}%s${NC}\n" "$1"
    printf "${RED}%s${NC}\n" "Huy cai dat..."
    exit 1
}

[[ "$(id -u)" == "0" ]] || die "Ban can dang nhap SSH voi user root."
[ -f /etc/os-release ] || die "Khong xac dinh duoc he dieu hanh."
command -v systemctl >/dev/null 2>&1 || die "Script yeu cau systemd."

RAM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
[[ ${RAM_TOTAL} -ge 400000 ]] || die "Canh bao: Dung luong RAM qua thap de cai Script. (It nhat 512MB)"

[ -f /etc/hostvn.lock ] && [ "${FORCE}" != "yes" ] && die "Script da duoc cai dat tren may nay. Go lenh: hostvn"

if [ "${FORCE}" != "yes" ]; then
    for svc in apache2 httpd mysqld mysql mariadb nginx; do
        if systemctl is-active --quiet "${svc}"; then
            die "Phat hien dich vu ${svc} dang chay. Script chi cai tren may chua cai web server/database (dung --force de bo qua)."
        fi
    done
    if [ -d /var/lib/mysql ] && [ -n "$(ls -A /var/lib/mysql 2>/dev/null)" ]; then
        die "Thu muc /var/lib/mysql da co du lieu. Hay sao luu va xoa truoc khi cai (hoac dung --force)."
    fi
fi

# Tools needed to fetch the source
if ! command -v curl >/dev/null 2>&1 || ! command -v tar >/dev/null 2>&1; then
    if command -v dnf >/dev/null 2>&1; then
        dnf -y install curl tar gzip
    else
        apt-get update -y && apt-get install -y curl tar gzip ca-certificates
    fi
fi

# Use the local checkout when the installer is started from a clone of the repository,
# otherwise download the repository.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SELF_DIR}/hostvn" ] && [ -f "${SELF_DIR}/menu/helpers/os" ]; then
    SRC_DIR="${SELF_DIR}"
else
    rm -rf "${SRC_DIR}"
    mkdir -p "${SRC_DIR}"
    curl -fsSL "https://github.com/${REPO_SLUG}/archive/refs/heads/${REPO_BRANCH}.tar.gz" |
        tar -xz --strip-components=1 -C "${SRC_DIR}" || die "Khong tai duoc source tu github.com/${REPO_SLUG}."
fi

# Files may have been edited on Windows
find "${SRC_DIR}" -type f \( -path "*/menu/*" -o -name hostvn -o -name version -o -name install \) \
    ! -name "*.tar.gz" ! -name ".DS_Store" -exec sed -i 's/\r$//' {} +

# shellcheck source=menu/helpers/os
source "${SRC_DIR}/menu/helpers/os"

if ! os_supported; then
    die "Rat tiec he dieu hanh ${OS_ID} ${OS_VERSION_ID} khong duoc ho tro. (Ubuntu 22.04+, Debian 11+, AlmaLinux/Rocky/Oracle Linux/CentOS Stream/RHEL 8+)"
fi

export LEMP_SRC_DIR="${SRC_DIR}"
export INSTALL_MODE REPO_SLUG REPO_BRANCH

cd "${SRC_DIR}" || exit 1
bash "${SRC_DIR}/hostvn"
