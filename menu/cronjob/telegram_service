#!/bin/bash

# Telegram alert when Nginx, MariaDB, PHP-FPM or CrowdSec is not running.
# Cron: */5 * * * *

source /var/hostvn/menu/helpers/os
source /var/hostvn/menu/helpers/apache
source /var/hostvn/menu/helpers/telegram

tg_load || exit 0

FILE_INFO="/var/hostvn/.hostvn.conf"
php1_version=$(grep -w "php1_version" "${FILE_INFO}" | cut -f2 -d'=')
php2_version=$(grep -w "php2_version" "${FILE_INFO}" | cut -f2 -d'=')
php2_release=$(grep -w "php2_release" "${FILE_INFO}" | cut -f2 -d'=')

services=("$(ws_service)" "mariadb")
# Apache behind Nginx
if ! ws_is_apache && ap_backend_enabled; then
    services+=("${AP_SERVICE}")
fi
[ -n "${php1_version}" ] && services+=("$(php_service "${php1_version}")")
if [ -n "${php2_version}" ] && [ "${php2_release}" == "yes" ]; then
    services+=("$(php_service "${php2_version}")")
fi
# Only watched when the admin installed and enabled them
for svc in crowdsec crowdsec-firewall-bouncer; do
    systemctl is-enabled --quiet "${svc}" 2>/dev/null && services+=("${svc}")
done

down=""
for svc in "${services[@]}"; do
    systemctl is-active --quiet "${svc}" || down="${down} ${svc}"
done

if [ -n "${down}" ]; then
    tg_notify "$(date "+%d %b %Y %H:%M"): CANH BAO - VPS $(tg_server_name): dich vu khong hoat dong:${down}"
fi
