#!/bin/bash

######################################################################
#        OS abstraction layer - shared by installer and menu         #
#                                                                    #
#  Supported: Ubuntu 22.04+ / Debian 11+ (apt, ufw)                  #
#             RHEL family 8+ : AlmaLinux, Rocky, Oracle Linux,       #
#             CentOS Stream, RHEL (dnf, firewalld)                   #
#                                                                    #
#  Original script: Sanvv - HOSTVN Technical (https://hostvn.vn)     #
######################################################################

# shellcheck disable=SC2034

# Repository that hosts this script (used for install + update).
REPO_SLUG="${REPO_SLUG:-hao159/linux-lemp-stack}"
REPO_BRANCH="${REPO_BRANCH:-master}"
REPO_RAW="https://raw.githubusercontent.com/${REPO_SLUG}/${REPO_BRANCH}"
REPO_TARBALL="https://github.com/${REPO_SLUG}/archive/refs/heads/${REPO_BRANCH}.tar.gz"

############################################
# Detect OS
############################################
os_detect() {
    OS_ID=""
    OS_LIKE=""
    OS_VERSION_ID=""
    OS_CODENAME=""
    if [ -f /etc/os-release ]; then
        OS_ID=$(. /etc/os-release && echo "${ID}")
        OS_LIKE=$(. /etc/os-release && echo "${ID_LIKE}")
        OS_VERSION_ID=$(. /etc/os-release && echo "${VERSION_ID}")
        OS_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME}")
    fi
    OS_MAJOR=${OS_VERSION_ID%%.*}

    case "${OS_ID}" in
    ubuntu | debian) OS_FAMILY="debian" ;;
    centos | rhel | almalinux | rocky | ol) OS_FAMILY="rhel" ;;
    *)
        case " ${OS_LIKE} " in
        *" debian "* | *" ubuntu "*) OS_FAMILY="debian" ;;
        *" rhel "* | *" fedora "* | *" centos "*) OS_FAMILY="rhel" ;;
        *) OS_FAMILY="unknown" ;;
        esac
        ;;
    esac

    if [ "${OS_FAMILY}" == "rhel" ]; then
        PKG_MGR="dnf"
        MYSQL_CNF="/etc/my.cnf"
        MYSQL_SOCK="/var/lib/mysql/mysql.sock"
        FIREWALL="firewalld"
        REDIS_SERVICE="redis"
        REDIS_CONF="/etc/redis/redis.conf"
        [ -f /etc/redis.conf ] && REDIS_CONF="/etc/redis.conf"
        MEMCACHED_CONF="/etc/sysconfig/memcached"
    else
        PKG_MGR="apt-get"
        MYSQL_CNF="/etc/mysql/my.cnf"
        MYSQL_SOCK="/run/mysqld/mysqld.sock"
        FIREWALL="ufw"
        REDIS_SERVICE="redis-server"
        REDIS_CONF="/etc/redis/redis.conf"
        MEMCACHED_CONF="/etc/memcached.conf"
    fi
}

# Return 0 when this OS release is supported.
os_supported() {
    case "${OS_ID}" in
    ubuntu)
        case "${OS_VERSION_ID}" in
        22.04 | 24.04 | 26.04) return 0 ;;
        esac
        ;;
    debian) [[ "${OS_MAJOR}" -ge 11 ]] && return 0 ;;
    centos | rhel | almalinux | rocky | ol) [[ "${OS_MAJOR}" -ge 8 ]] && return 0 ;;
    esac
    return 1
}

############################################
# Package manager
############################################
pkg_update() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y makecache
    else
        apt-get update -y
    fi
}

pkg_upgrade() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y upgrade
    else
        DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
        apt-get autoremove -y
    fi
}

# Install packages, all of them are required.
pkg_install() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y install "$@"
    else
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
    fi
}

# Install packages one by one, a missing package does not stop the others.
pkg_install_optional() {
    local p
    for p in "$@"; do
        pkg_install "${p}" >/dev/null 2>&1 || printf "  - skip package (not available): %s\n" "${p}"
    done
}

pkg_remove() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y remove "$@"
    else
        DEBIAN_FRONTEND=noninteractive apt-get purge --auto-remove -y "$@"
    fi
}

pkg_autoremove() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y autoremove
    else
        apt-get autoremove -y
    fi
}

############################################
# Base system
############################################
# EPEL + CodeReady/PowerTools on the RHEL family (needed by Remi and by build deps)
os_enable_extra_repos() {
    [ "${OS_FAMILY}" == "rhel" ] || return 0

    dnf -y install dnf-plugins-core
    if [ "${OS_ID}" == "ol" ]; then
        dnf -y install "oracle-epel-release-el${OS_MAJOR}"
        dnf config-manager --set-enabled "ol${OS_MAJOR}_codeready_builder" 2>/dev/null
    else
        dnf -y install epel-release 2>/dev/null ||
            dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-${OS_MAJOR}.noarch.rpm"
        if [ "${OS_MAJOR}" == "8" ]; then
            dnf config-manager --set-enabled powertools 2>/dev/null
        else
            dnf config-manager --set-enabled crb 2>/dev/null
        fi
        if [ "${OS_ID}" == "rhel" ]; then
            subscription-manager repos --enable "codeready-builder-for-rhel-${OS_MAJOR}-$(arch)-rpms" 2>/dev/null
        fi
    fi
}

os_install_base() {
    os_enable_extra_repos
    pkg_update

    if [ "${OS_FAMILY}" == "rhel" ]; then
        # curl is not listed: EL9+ ships curl-minimal which conflicts with the curl package
        pkg_install gcc gcc-c++ make perl openssl openssl-devel zlib-devel pcre2-devel git wget tar \
            unzip zip bzip2 ca-certificates cronie logrotate bc which procps-ng psmisc findutils \
            httpd-tools bind-utils net-tools tzdata util-linux shadow-utils sudo || return 1
        pkg_install_optional brotli-devel libxml2-devel dos2unix htop nano supervisor rsyslog ImageMagick \
            libwebp-tools gifsicle optipng jpegoptim pngquant policycoreutils-python-utils jq
        systemctl enable --now crond 2>/dev/null
    else
        pkg_install build-essential perl openssl libssl-dev zlib1g-dev libpcre2-dev git wget curl tar \
            unzip zip bzip2 ca-certificates cron logrotate bc procps psmisc findutils apache2-utils \
            dnsutils net-tools tzdata gnupg lsb-release sudo || return 1
        pkg_install_optional libbrotli-dev libxml2-dev dos2unix htop nano supervisor rsyslog imagemagick \
            webp gifsicle optipng jpegoptim pngquant apt-transport-https jq
    fi

    systemctl stop supervisor supervisord 2>/dev/null
    systemctl disable supervisor supervisord 2>/dev/null
    return 0
}

# PHP-FPM (Remi) runs confined by SELinux and can not read /home/<user>/<domain>.
os_selinux_permissive() {
    if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" == "Enforcing" ]; then
        setenforce 0
        sed -i 's/^SELINUX=enforcing/SELINUX=permissive/' /etc/selinux/config
    fi
}

os_add_group() {
    getent group "$1" >/dev/null 2>&1 || groupadd "$1"
}

os_add_nginx_user() {
    getent group nginx >/dev/null 2>&1 || groupadd -r nginx
    id nginx >/dev/null 2>&1 || useradd -r -g nginx -s /usr/sbin/nologin -d /nonexistent -M -c "nginx user" nginx
}

get_local_ip() {
    local ip_addr
    ip_addr=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    if [ -z "${ip_addr}" ]; then
        ip_addr=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    echo "${ip_addr}"
}

get_public_ip() {
    local ip_addr="" url
    for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
        ip_addr=$(curl -s -4 -m 8 "${url}" 2>/dev/null | tr -d '[:space:]')
        if [[ "${ip_addr}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "${ip_addr}"
            return 0
        fi
    done
    get_local_ip
}

# Read a key from the version file of the repository (fallback: local copy).
get_version() {
    local value=""
    # During installation the version file shipped with the source is the reference
    if [ -n "${LEMP_SRC_DIR}" ] && [ -f "${LEMP_SRC_DIR}/version" ]; then
        grep "^${1}=" "${LEMP_SRC_DIR}/version" | cut -f2 -d'='
        return 0
    fi
    value=$(curl -s -m 15 "${REPO_RAW}/version" 2>/dev/null | grep "^${1}=" | cut -f2 -d'=')
    if [ -z "${value}" ] && [ -f /var/hostvn/version ]; then
        value=$(grep "^${1}=" /var/hostvn/version | cut -f2 -d'=')
    fi
    echo "${value}"
}

############################################
# Firewall (ufw on Debian family, firewalld on RHEL family)
############################################
fw_active() {
    if [ "${FIREWALL}" == "firewalld" ]; then
        systemctl is-active --quiet firewalld
    else
        ufw status 2>/dev/null | grep -q "Status: active"
    fi
}

fw_install() {
    if [ "${FIREWALL}" == "firewalld" ]; then
        command -v firewall-cmd >/dev/null 2>&1 || pkg_install firewalld
    else
        command -v ufw >/dev/null 2>&1 || pkg_install ufw
    fi
}

# Enable the firewall. The SSH port(s) are always allowed first.
fw_enable() {
    fw_install
    if [ "${FIREWALL}" == "firewalld" ]; then
        systemctl enable --now firewalld
        firewall-cmd --permanent --add-service=ssh >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw allow ssh >/dev/null
        systemctl enable ufw >/dev/null 2>&1
        ufw --force enable
    fi
}

fw_disable() {
    if [ "${FIREWALL}" == "firewalld" ]; then
        systemctl disable --now firewalld
    else
        ufw --force disable
        systemctl stop ufw
        systemctl disable ufw
    fi
}

fw_reload() {
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        firewall-cmd --reload >/dev/null
    else
        ufw reload >/dev/null
    fi
}

# fw_allow_port <port> [tcp|udp]  - does nothing when the firewall is not running
fw_allow_port() {
    local proto="${2:-tcp}"
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        firewall-cmd --permanent --add-port="${1}/${proto}" >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw allow "${1}/${proto}" >/dev/null
    fi
}

fw_remove_port() {
    local proto="${2:-tcp}"
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        firewall-cmd --permanent --remove-port="${1}/${proto}" >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw delete allow "${1}/${proto}" >/dev/null 2>&1
        ufw delete allow "${1}" >/dev/null 2>&1
    fi
}

fw_deny_port() {
    local proto="${2:-tcp}"
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        firewall-cmd --permanent --remove-port="${1}/${proto}" >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw delete allow "${1}/${proto}" >/dev/null 2>&1
        ufw deny "${1}/${proto}" >/dev/null
    fi
}

fw_block_ip() {
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        local family="ipv4"
        [[ "$1" == *:* ]] && family="ipv6"
        firewall-cmd --permanent --add-rich-rule="rule family='${family}' source address='${1}' drop" >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw insert 1 deny from "$1" to any >/dev/null
    fi
}

fw_unblock_ip() {
    fw_active || return 0
    if [ "${FIREWALL}" == "firewalld" ]; then
        local family="ipv4"
        [[ "$1" == *:* ]] && family="ipv6"
        firewall-cmd --permanent --remove-rich-rule="rule family='${family}' source address='${1}' drop" >/dev/null
        firewall-cmd --reload >/dev/null
    else
        ufw delete deny from "$1" to any >/dev/null
    fi
}

############################################
# PHP
#   Debian family : Ondrej PPA (Ubuntu) / packages.sury.org (Debian)
#   RHEL family   : Remi repository (parallel installable phpXY packages)
#
# On the RHEL family a compatibility layout is created so the same paths
# and service names work everywhere:
#   /etc/php/X.Y/fpm            -> /etc/opt/remi/phpXY
#   /etc/php/X.Y/fpm/conf.d     -> php.d
#   /etc/php/X.Y/fpm/pool.d     -> php-fpm.d
#   /etc/php/X.Y/cli/conf.d        (unused placeholder, CLI reads php.d)
#   phpX.Y-fpm.service          -> phpXY-php-fpm.service
#   /usr/bin/phpX.Y, phpizeX.Y, php-configX.Y
############################################
_php_nodot() {
    echo "${1//./}"
}

# Real systemd unit name (use for enable/disable, start/stop work with both names)
php_service() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        echo "php$(_php_nodot "$1")-php-fpm"
    else
        echo "php${1}-fpm"
    fi
}

php_repo_setup() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        if ! rpm -q remi-release >/dev/null 2>&1; then
            dnf -y install "https://rpms.remirepo.net/enterprise/remi-release-${OS_MAJOR}.rpm"
        fi
        return 0
    fi

    [ -f /etc/apt/sources.list.d/php-sury.list ] && return 0
    ls /etc/apt/sources.list.d/ 2>/dev/null | grep -q "ondrej.*php" && return 0

    if [ "${OS_ID}" == "ubuntu" ] &&
        curl -sfI -m 15 "https://ppa.launchpadcontent.net/ondrej/php/ubuntu/dists/${OS_CODENAME}/Release" >/dev/null; then
        pkg_install software-properties-common
        add-apt-repository -y ppa:ondrej/php
    else
        # Debian, or an Ubuntu release that the PPA does not carry yet
        mkdir -p /usr/share/keyrings
        curl -sSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
        dpkg -i /tmp/debsuryorg-archive-keyring.deb
        rm -f /tmp/debsuryorg-archive-keyring.deb
        echo "deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ ${OS_CODENAME} main" \
            >/etc/apt/sources.list.d/php-sury.list
    fi
    apt-get update -y
}

# Hardening + limits for the php-fpm unit (drop-in, survives package updates)
_php_service_dropin() {
    local svc
    svc=$(php_service "$1")
    mkdir -p "/etc/systemd/system/${svc}.service.d"
    cat >"/etc/systemd/system/${svc}.service.d/hostvn.conf" <<EOF
[Service]
LimitNOFILE=65535
LimitMEMLOCK=infinity
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
EOF
}

_php_rhel_compat() {
    local ver="$1" nd scl_etc scl_root svc
    nd=$(_php_nodot "${ver}")
    scl_etc="/etc/opt/remi/php${nd}"
    scl_root="/opt/remi/php${nd}/root"
    svc=$(php_service "${ver}")

    mkdir -p "/etc/php/${ver}/cli/conf.d"
    ln -sfn "${scl_etc}" "/etc/php/${ver}/fpm"
    ln -sfn php.d "${scl_etc}/conf.d"
    ln -sfn php-fpm.d "${scl_etc}/pool.d"

    ln -sf "${scl_root}/usr/bin/php" "/usr/bin/php${ver}"
    ln -sf "${scl_root}/usr/bin/phpize" "/usr/bin/phpize${ver}"
    ln -sf "${scl_root}/usr/bin/php-config" "/usr/bin/php-config${ver}"
    ln -sf "${scl_root}/usr/sbin/php-fpm" "/usr/sbin/php-fpm${ver}"

    # Service alias: systemctl restart php8.3-fpm
    ln -sf "/usr/lib/systemd/system/${svc}.service" "/etc/systemd/system/php${ver}-fpm.service"

    # Socket / pid directory shared by all PHP versions
    echo "d /run/php 0755 root root -" >/etc/tmpfiles.d/hostvn-php.conf
    systemd-tmpfiles --create /etc/tmpfiles.d/hostvn-php.conf
}

# php_install <X.Y>
php_install() {
    local ver="$1" nd p
    nd=$(_php_nodot "${ver}")
    php_repo_setup

    if [ "${OS_FAMILY}" == "rhel" ]; then
        p="php${nd}-php"
        pkg_install "php${nd}" "${p}-fpm" "${p}-cli" "${p}-common" "${p}-mysqlnd" "${p}-gd" "${p}-xml" \
            "${p}-mbstring" "${p}-devel" || return 1
        pkg_install_optional "${p}-opcache" "${p}-ldap" "${p}-pecl-zip" "${p}-soap" "${p}-bcmath" "${p}-snmp" "${p}-pspell" \
            "${p}-gmp" "${p}-intl" "${p}-imap" "${p}-pecl-imap" "${p}-enchant" "${p}-pecl-xmlrpc" "${p}-tidy" \
            "${p}-pecl-imagick" "${p}-pecl-imagick-im7" "${p}-pdo" "${p}-process" "${p}-sodium" "${p}-json"
        _php_rhel_compat "${ver}"
    else
        p="php${ver}"
        pkg_install "${p}" "${p}-fpm" "${p}-cli" "${p}-common" "${p}-mysql" "${p}-gd" "${p}-xml" \
            "${p}-mbstring" "${p}-curl" "${p}-zip" "${p}-dev" || return 1
        pkg_install_optional "${p}-opcache" "${p}-ldap" "${p}-soap" "${p}-bcmath" "${p}-snmp" "${p}-pspell" "${p}-gmp" \
            "${p}-intl" "${p}-imap" "${p}-enchant" "${p}-xmlrpc" "${p}-tidy" "${p}-imagick" "${p}-sqlite3"
        # json is part of PHP core since 8.0, mcrypt was removed in 7.2
        case "${ver}" in
        5.* | 7.*) pkg_install_optional "${p}-json" ;;
        esac
        [ "${ver}" == "5.6" ] && pkg_install_optional php5.6-mcrypt
        # Apache may be pulled in as a dependency of the phpX.Y meta package
        if ! declare -F ap_in_use >/dev/null || ! ap_in_use; then
            systemctl disable --now apache2 >/dev/null 2>&1
        fi
    fi

    _php_service_dropin "${ver}"
    systemctl daemon-reload
    return 0
}

php_remove() {
    local ver="$1" nd
    nd=$(_php_nodot "${ver}")
    systemctl stop "$(php_service "${ver}")" 2>/dev/null
    systemctl disable "$(php_service "${ver}")" 2>/dev/null

    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y remove "php${nd}" "php${nd}-*"
        rm -f "/usr/bin/php${ver}" "/usr/bin/phpize${ver}" "/usr/bin/php-config${ver}" "/usr/sbin/php-fpm${ver}"
        rm -f "/etc/systemd/system/php${ver}-fpm.service"
        rm -rf "/etc/opt/remi/php${nd}"
    else
        DEBIAN_FRONTEND=noninteractive apt-get purge -y "php${ver}" "php${ver}-*"
        apt-get autoremove -y
    fi
    rm -rf "/etc/php/${ver}" "/etc/systemd/system/$(php_service "${ver}").service.d"
    systemctl daemon-reload
}

# Make "php" point to the given version
php_set_default() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        ln -sf "/usr/bin/php${1}" /usr/bin/php
        ln -sf "/usr/bin/phpize${1}" /usr/bin/phpize
        ln -sf "/usr/bin/php-config${1}" /usr/bin/php-config
    else
        update-alternatives --set php "/usr/bin/php${1}"
        update-alternatives --set phpize "/usr/bin/phpize${1}" 2>/dev/null
        update-alternatives --set php-config "/usr/bin/php-config${1}" 2>/dev/null
    fi
}

# Extensions offered by the menu (PHP -> Cai dat extension), named as "php -m" prints them.
PHP_EXT_LIST="mongodb redis memcached pgsql sqlite3 intl imagick gd zip bcmath gmp soap xsl mbstring curl iconv exif apcu igbinary msgpack ldap imap tidy yaml ssh2 uuid mailparse amqp swoole xdebug"

# pkg_available <package> : the repositories have this package
pkg_available() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -q info "$1" >/dev/null 2>&1
    else
        LC_ALL=C apt-cache policy "$1" 2>/dev/null | grep -q 'Candidate: [^(]'
    fi
}

# php_ext_loaded <X.Y> <extension>
php_ext_loaded() {
    "php${1}" -m 2>/dev/null | grep -qix -- "$2"
}

# php_ext_packages <X.Y> <extension> : package names to try, the first one available is used.
# Ondrej/Sury name them phpX.Y-<ext>, Remi phpXY-php-<ext> or phpXY-php-pecl-<ext>.
php_ext_packages() {
    local ver="$1" ext="$2" p
    if [ "${OS_FAMILY}" == "rhel" ]; then
        p="php$(_php_nodot "${ver}")-php"
        case "${ext}" in
        redis) echo "${p}-pecl-redis6 ${p}-pecl-redis5 ${p}-pecl-redis" ;;
        imagick) echo "${p}-pecl-imagick-im7 ${p}-pecl-imagick-im6 ${p}-pecl-imagick" ;;
        swoole) echo "${p}-pecl-swoole6 ${p}-pecl-swoole5 ${p}-pecl-swoole" ;;
        xdebug) echo "${p}-pecl-xdebug3 ${p}-pecl-xdebug" ;;
        imap) echo "${p}-imap ${p}-pecl-imap" ;;
        zip) echo "${p}-pecl-zip" ;;
        sqlite3) echo "${p}-pdo" ;;
        xsl) echo "${p}-xml" ;;
        curl | iconv | exif) echo "${p}-common" ;;
        pgsql | intl | gd | bcmath | gmp | soap | mbstring | ldap | tidy) echo "${p}-${ext}" ;;
        *) echo "${p}-pecl-${ext} ${p}-${ext}" ;;
        esac
    else
        case "${ext}" in
        xsl) echo "php${ver}-xml" ;;
        iconv | exif) echo "php${ver}-common" ;;
        *) echo "php${ver}-${ext}" ;;
        esac
    fi
}

# php_ext_install <X.Y> <extension>  - prebuilt packages, no compiling
# Returns 2 when no repository has a package for this extension and PHP version.
php_ext_install() {
    local pkg
    for pkg in $(php_ext_packages "$1" "$2"); do
        if pkg_available "${pkg}"; then
            pkg_install "${pkg}"
            return $?
        fi
    done
    return 2
}

php_ext_remove() {
    local ver="$1" ext="$2" nd
    nd=$(_php_nodot "${ver}")
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y remove "php${nd}-php-pecl-${ext}*"
    else
        DEBIAN_FRONTEND=noninteractive apt-get purge -y "php${ver}-${ext}"
    fi
}

# OPcache is compiled into PHP since 8.5, loading the shared object again only prints a warning.
php_opcache_load_line() {
    local major=${1%%.*} minor=${1##*.}
    if [[ "${major}" -gt 8 || ("${major}" -eq 8 && "${minor}" -ge 5) ]]; then
        echo "; opcache is built into PHP ${1}"
    else
        echo "zend_extension=opcache.so"
    fi
}

############################################
# MariaDB
############################################
# mariadb_install <version, ex: 11.8>
mariadb_install() {
    local ver="$1"
    if [ "${OS_FAMILY}" == "rhel" ]; then
        cat >/etc/yum.repos.d/MariaDB.repo <<EOF
[mariadb]
name = MariaDB ${ver}
baseurl = https://rpm.mariadb.org/${ver}/rhel/${OS_MAJOR}/\$basearch
gpgkey = https://rpm.mariadb.org/RPM-GPG-KEY-MariaDB
gpgcheck = 1
module_hotfixes = 1
EOF
        dnf -y makecache
        pkg_install MariaDB-server MariaDB-client || return 1
        pkg_install_optional MariaDB-backup MariaDB-client-compat MariaDB-server-compat
        mkdir -p /etc/my.cnf.d
    else
        mkdir -p /etc/apt/keyrings
        curl -sSLo /etc/apt/keyrings/mariadb-keyring.pgp https://mariadb.org/mariadb_release_signing_key.pgp
        echo "deb [signed-by=/etc/apt/keyrings/mariadb-keyring.pgp] https://deb.mariadb.org/${ver}/${OS_ID} ${OS_CODENAME} main" \
            >/etc/apt/sources.list.d/mariadb.list
        if ! apt-get update -y || ! apt-cache policy mariadb-server | grep -q "deb.mariadb.org"; then
            # This release is not published by MariaDB yet: use the distribution package
            rm -f /etc/apt/sources.list.d/mariadb.list
            apt-get update -y
        fi
        pkg_install mariadb-server mariadb-client || return 1
        pkg_install_optional mariadb-backup mariadb-client-compat mariadb-server-compat
    fi

    # Old client names are still used all over the menu
    local pair new old
    for pair in mariadb:mysql mariadb-dump:mysqldump mariadb-admin:mysqladmin mariadb-show:mysqlshow mariadb-check:mysqlcheck; do
        new=${pair%%:*}
        old=${pair##*:}
        if ! command -v "${old}" >/dev/null 2>&1 && command -v "${new}" >/dev/null 2>&1; then
            ln -sf "$(command -v "${new}")" "/usr/bin/${old}"
        fi
    done
    return 0
}

############################################
# Nginx (built from source so every OS gets the same binary).
# Third party modules are optional: only the ones listed in
# NGINX_MODULES_FILE are compiled in (none = plain Nginx, lightest).
############################################
# LuaJIT and the Lua libraries live in their own prefix, the default search path of
# this LuaJIT points there so Nginx needs no lua_package_path to find resty.core.
NGINX_LUAJIT_PREFIX="/usr/local/hostvn-luajit"
NGINX_MODULES_FILE="/var/hostvn/nginx_modules"
NGINX_MODULES_ALL="brotli headers_more lua vts cache_purge"

# nginx_module_label <module>
nginx_module_label() {
    case "$1" in
    brotli) echo "Brotli - nen tot hon gzip, ton them CPU" ;;
    headers_more) echo "Headers-More - sua/xoa header (can cho FastCGI cache WooCommerce)" ;;
    lua) echo "Lua (LuaJIT) - can cho CrowdSec AppSec (WAF), ton them RAM" ;;
    vts) echo "VTS - thong ke traffic theo vhost" ;;
    cache_purge) echo "Cache Purge - xoa FastCGI cache theo URL" ;;
    *) echo "$1" ;;
    esac
}

# Name of the module in "nginx -V"
_nginx_module_src() {
    case "$1" in
    brotli) echo "ngx_brotli" ;;
    headers_more) echo "headers-more-nginx-module" ;;
    lua) echo "lua-nginx-module" ;;
    vts) echo "nginx-module-vts" ;;
    cache_purge) echo "ngx_cache_purge" ;;
    esac
}

# nginx_has_module <module> : compiled into the running binary
nginx_has_module() {
    local src
    src=$(_nginx_module_src "$1")
    [ -n "${src}" ] && nginx -V 2>&1 | grep -q -- "${src}"
}

nginx_has_lua() {
    nginx_has_module lua
}

# Modules to build. Servers installed before the list existed had every module.
nginx_modules_get() {
    if [ -f "${NGINX_MODULES_FILE}" ]; then
        tr -s ' \n' ' ' <"${NGINX_MODULES_FILE}" | sed 's/^ //; s/ $//'
    else
        echo "${NGINX_MODULES_ALL}"
    fi
}

# nginx_modules_sort <module>... : canonical order, unknown names dropped
nginx_modules_sort() {
    local m out=""
    for m in ${NGINX_MODULES_ALL}; do
        [[ " $* " == *" ${m} "* ]] && out="${out} ${m}"
    done
    echo "${out# }"
}

# nginx_modules_set <module>... : the list used by the next build
nginx_modules_set() {
    mkdir -p "$(dirname "${NGINX_MODULES_FILE}")"
    nginx_modules_sort "$@" >"${NGINX_MODULES_FILE}"
}

nginx_module_selected() {
    [[ " $(nginx_modules_get) " == *" $1 "* ]]
}

nginx_modules_add() {
    nginx_module_selected "$1" && return 0
    # shellcheck disable=SC2046
    nginx_modules_set $(nginx_modules_get) "$1"
}

nginx_modules_del() {
    local m keep=""
    for m in $(nginx_modules_get); do
        [ "${m}" != "$1" ] && keep="${keep} ${m}"
    done
    # shellcheck disable=SC2086
    nginx_modules_set ${keep}
}

# Write the parts of the configuration that depend on a module, for the modules that
# the installed binary really has. Run after every build, before "nginx -t".
nginx_modules_conf() {
    local extra="/etc/nginx/extra" main="/etc/nginx/nginx.conf"
    [ -d "${extra}" ] || return 0

    if nginx_has_module brotli; then
        cat >"${extra}/brotli.conf" <<'EOFBRCONF'
##Brotli Compression
brotli on;
brotli_static on;
brotli_buffers 16 8k;
brotli_comp_level 5;
brotli_types
    application/atom+xml
    application/geo+json
    application/javascript
    application/json
    application/ld+json
    application/manifest+json
    application/rdf+xml
    application/rss+xml
    application/vnd.ms-fontobject
    application/wasm
    application/x-font-opentype
    application/x-font-truetype
    application/x-font-ttf
    application/x-javascript
    application/x-web-app-manifest+json
    application/xhtml+xml
    application/xml
    application/xml+rss
    font/eot
    font/opentype
    font/otf
    image/bmp
    image/svg+xml
    image/vnd.microsoft.icon
    image/x-icon
    image/x-win-bitmap
    text/cache-manifest
    text/calendar
    text/css
    text/javascript
    text/markdown
    text/plain
    text/vcard
    text/vnd.rim.location.xloc
    text/vtt
    text/x-component
    text/x-cross-domain-policy
    text/xml;
EOFBRCONF
    else
        echo "# Brotli: Nginx chua build kem module nay (hostvn -> LEMP -> Nginx -> Module Nginx)" \
            >"${extra}/brotli.conf"
    fi
    # Images and archives are never pre-compressed, the directive is not needed
    sed -i '/brotli_static off;/d' "${extra}/staticfiles.conf" 2>/dev/null

    if nginx_has_module headers_more; then
        cat >"${extra}/headers.conf" <<'EOheaders'
# Custom Response Headers (headers-more)
more_set_headers 'Server: HOSTVN.NET';
more_set_headers 'X-Content-Type-Options: nosniff';
more_set_headers 'X-XSS-Protection: 1; mode=block';
more_set_headers 'Strict-Transport-Security: max-age=31536000; includeSubDomains; preload';
more_set_headers 'Referrer-Policy: no-referrer-when-downgrade';
EOheaders
    else
        cat >"${extra}/headers.conf" <<'EOheaders'
# Custom Response Headers (core add_header, a location with its own add_header does not inherit them)
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
add_header Referrer-Policy "no-referrer-when-downgrade" always;
EOheaders
    fi
    # Older nginx.conf had the headers inline
    if [ -f "${main}" ] && ! grep -q "extra/headers.conf" "${main}"; then
        sed -i '/^[[:space:]]*more_set_headers /d' "${main}"
        sed -i "0,/^\([[:space:]]*\)include[[:space:]]\+\/etc\/nginx\/extra\/nginx_cache\.conf;/s||\1include /etc/nginx/extra/headers.conf;\n&|" "${main}"
    fi
    return 0
}

# _nginx_build_lua : run inside the module directory, sources already downloaded
_nginx_build_lua() {
    local lj="${NGINX_LUAJIT_PREFIX}" share cpath
    share="${lj}/share/lua/5.1"
    cpath="${lj}/lib/lua/5.1"

    (cd "luajit2-${luajit_v}" &&
        make -j"$(nproc)" PREFIX="${lj}" &&
        make install PREFIX="${lj}") || return 1

    mkdir -p "${share}/resty" "${cpath}"
    cp -r "lua-resty-core-${resty_core_v}"/lib/* "${share}/" || return 1
    cp -r "lua-resty-lrucache-${resty_lrucache_v}"/lib/* "${share}/" || return 1
    cp "lua-resty-http-${resty_http_v}"/lib/resty/*.lua "${share}/resty/" || return 1
    # required by lua-resty-http
    cp "lua-resty-string-${resty_string_v}"/lib/resty/*.lua "${share}/resty/" || return 1

    (cd "lua-cjson-${cjson_v}" &&
        make LUA_INCLUDE_DIR="${lj}/include/luajit-2.1" &&
        install -m 755 cjson.so "${cpath}/cjson.so") || return 1
}

# _nginx_fetch <url> : download and unpack a tarball in the current directory
_nginx_fetch() {
    wget -qO- "$1" | tar -xz
}

# nginx_build <version> [module...]
# Without a module list the saved one is used (nginx_modules_get), so an update or a
# rebuild keeps the modules the administrator chose.
nginx_build() {
    local ver="$1" module_path="/usr/share/nginx_module" m modules
    local cache_purge_v headers_more_v vts_v
    local luajit_v ndk_v lua_module_v resty_core_v resty_lrucache_v cjson_v resty_http_v resty_string_v
    local add=() env=()
    shift
    if [ $# -gt 0 ]; then
        modules="$*"
    else
        modules=$(nginx_modules_get)
    fi

    if [ -z "${ver}" ]; then
        echo "Can not read the nginx version from the version file."
        return 1
    fi

    rm -rf "${module_path}"
    mkdir -p "${module_path}"
    cd "${module_path}" || return 1

    _nginx_fetch "https://nginx.org/download/nginx-${ver}.tar.gz"
    [ -d "nginx-${ver}" ] || {
        echo "Download nginx ${ver} failed."
        return 1
    }

    for m in ${modules}; do
        case "${m}" in
        cache_purge)
            cache_purge_v=$(get_version ngx_cache_purge_version)
            _nginx_fetch "https://github.com/nginx-modules/ngx_cache_purge/archive/refs/tags/${cache_purge_v}.tar.gz"
            [ -n "${cache_purge_v}" ] && [ -d "ngx_cache_purge-${cache_purge_v}" ] || {
                echo "Download ngx_cache_purge failed."
                return 1
            }
            add+=("--add-module=../ngx_cache_purge-${cache_purge_v}")
            ;;
        headers_more)
            headers_more_v=$(get_version more_clear_headers_v)
            _nginx_fetch "https://github.com/openresty/headers-more-nginx-module/archive/refs/tags/v${headers_more_v}.tar.gz"
            [ -n "${headers_more_v}" ] && [ -d "headers-more-nginx-module-${headers_more_v}" ] || {
                echo "Download headers-more failed."
                return 1
            }
            add+=("--add-module=../headers-more-nginx-module-${headers_more_v}")
            ;;
        vts)
            vts_v=$(get_version nginx_module_vts_v)
            _nginx_fetch "https://github.com/vozlt/nginx-module-vts/archive/refs/tags/v${vts_v}.tar.gz"
            [ -n "${vts_v}" ] && [ -d "nginx-module-vts-${vts_v}" ] || {
                echo "Download nginx-module-vts failed."
                return 1
            }
            add+=("--add-module=../nginx-module-vts-${vts_v}")
            ;;
        brotli)
            command -v git >/dev/null 2>&1 || pkg_install git
            git clone --depth 1 --recurse-submodules --shallow-submodules https://github.com/google/ngx_brotli
            [ -d ngx_brotli ] || {
                echo "Download ngx_brotli failed."
                return 1
            }
            # Without the system brotli library the bundled copy has to be built first
            if ! [ -f /usr/include/brotli/encode.h ]; then
                pkg_install cmake
                mkdir -p ngx_brotli/deps/brotli/out
                (cd ngx_brotli/deps/brotli/out &&
                    cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCMAKE_INSTALL_PREFIX=./installed .. &&
                    cmake --build . --config Release --target brotlienc) || return 1
            fi
            add+=("--add-module=../ngx_brotli")
            ;;
        lua)
            # CrowdSec AppSec bouncer
            luajit_v=$(get_version luajit_version)
            ndk_v=$(get_version ngx_devel_kit_version)
            lua_module_v=$(get_version lua_nginx_module_version)
            resty_core_v=$(get_version lua_resty_core_version)
            resty_lrucache_v=$(get_version lua_resty_lrucache_version)
            cjson_v=$(get_version lua_cjson_version)
            resty_http_v=$(get_version lua_resty_http_version)
            resty_string_v=$(get_version lua_resty_string_version)
            if [ -z "${luajit_v}" ] || [ -z "${ndk_v}" ] || [ -z "${lua_module_v}" ] || [ -z "${resty_core_v}" ] ||
                [ -z "${resty_lrucache_v}" ] || [ -z "${cjson_v}" ] || [ -z "${resty_http_v}" ] ||
                [ -z "${resty_string_v}" ]; then
                echo "Can not read the Lua versions from the version file."
                return 1
            fi
            _nginx_fetch "https://github.com/openresty/luajit2/archive/refs/tags/v${luajit_v}.tar.gz"
            _nginx_fetch "https://github.com/vision5/ngx_devel_kit/archive/refs/tags/v${ndk_v}.tar.gz"
            _nginx_fetch "https://github.com/openresty/lua-nginx-module/archive/refs/tags/v${lua_module_v}.tar.gz"
            _nginx_fetch "https://github.com/openresty/lua-resty-core/archive/refs/tags/v${resty_core_v}.tar.gz"
            _nginx_fetch "https://github.com/openresty/lua-resty-lrucache/archive/refs/tags/v${resty_lrucache_v}.tar.gz"
            _nginx_fetch "https://github.com/openresty/lua-cjson/archive/refs/tags/${cjson_v}.tar.gz"
            _nginx_fetch "https://github.com/ledgetech/lua-resty-http/archive/refs/tags/v${resty_http_v}.tar.gz"
            _nginx_fetch "https://github.com/openresty/lua-resty-string/archive/refs/tags/v${resty_string_v}.tar.gz"
            if [ ! -d "luajit2-${luajit_v}" ] || [ ! -d "ngx_devel_kit-${ndk_v}" ] ||
                [ ! -d "lua-nginx-module-${lua_module_v}" ] || [ ! -d "lua-resty-core-${resty_core_v}" ] ||
                [ ! -d "lua-resty-lrucache-${resty_lrucache_v}" ] || [ ! -d "lua-cjson-${cjson_v}" ] ||
                [ ! -d "lua-resty-http-${resty_http_v}" ] || [ ! -d "lua-resty-string-${resty_string_v}" ]; then
                echo "Download Lua sources failed."
                return 1
            fi
            if ! _nginx_build_lua; then
                echo "Build LuaJIT failed."
                return 1
            fi
            add+=("--add-module=../ngx_devel_kit-${ndk_v}" "--add-module=../lua-nginx-module-${lua_module_v}"
                "--with-ld-opt=-Wl,-rpath,${NGINX_LUAJIT_PREFIX}/lib")
            env=("LUAJIT_LIB=${NGINX_LUAJIT_PREFIX}/lib" "LUAJIT_INC=${NGINX_LUAJIT_PREFIX}/include/luajit-2.1")
            ;;
        esac
    done

    cd "${module_path}/nginx-${ver}" || return 1
    env "${env[@]}" \
        ./configure \
        "--user=nginx" \
        "--group=nginx" \
        "--prefix=/usr" \
        "--sbin-path=/usr/sbin" \
        "--conf-path=/etc/nginx/nginx.conf" \
        "--pid-path=/run/nginx.pid" \
        "--lock-path=/run/nginx.lock" \
        "--http-log-path=/var/log/nginx/access_log" \
        "--error-log-path=/var/log/nginx/error_log" \
        "--http-client-body-temp-path=/var/cache/nginx/client_temp" \
        "--http-proxy-temp-path=/var/cache/nginx/proxy_temp" \
        "--http-fastcgi-temp-path=/var/cache/nginx/fastcgi_temp" \
        "--http-uwsgi-temp-path=/var/cache/nginx/uwsgi_temp" \
        "--http-scgi-temp-path=/var/cache/nginx/scgi_temp" \
        "--without-mail_imap_module" \
        "--without-mail_smtp_module" \
        "--with-threads" \
        "--with-file-aio" \
        "--with-http_ssl_module" \
        "--with-http_realip_module" \
        "--with-http_stub_status_module" \
        "--with-http_gzip_static_module" \
        "--with-http_dav_module" \
        "--with-http_v2_module" \
        "--with-http_sub_module" \
        "--with-http_auth_request_module" \
        "--with-pcre-jit" \
        "${add[@]}" \
        "--with-cc-opt=-DFD_SETSIZE=32768" || return 1

    make -j"$(nproc)" || return 1
    make install || return 1

    mkdir -p /var/cache/nginx /var/log/nginx
    return 0
}

nginx_install_service() {
    os_add_nginx_user
    mkdir -p /var/cache/nginx /var/log/nginx /etc/nginx/conf.d
    chown nginx:nginx /var/cache/nginx

    cat >/etc/systemd/system/nginx.service <<EOnginx_service
[Unit]
Description=The nginx HTTP and reverse proxy server
After=network-online.target remote-fs.target nss-lookup.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/nginx.conf
ExecReload=/bin/kill -s HUP \$MAINPID
ExecStop=/bin/kill -s QUIT \$MAINPID
PrivateTmp=true
LimitMEMLOCK=infinity
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOnginx_service

    cat >/etc/logrotate.d/nginx <<'EOnginx_logrotate'
/var/log/nginx/*.log {
    weekly
    missingok
    rotate 8
    compress
    delaycompress
    notifempty
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
EOnginx_logrotate

    systemctl daemon-reload
    systemctl enable nginx.service
}

############################################
# Redis / Memcached
############################################
redis_installed() {
    systemctl list-unit-files 2>/dev/null | grep -qE "^(redis|redis-server|valkey)\.service"
}

redis_install() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        # EL10 ships valkey (drop-in replacement) instead of redis
        if ! pkg_install redis; then
            pkg_install valkey valkey-compat-redis || return 1
        fi
        if [ ! -f /usr/lib/systemd/system/redis.service ] && [ -f /usr/lib/systemd/system/valkey.service ]; then
            ln -sf /usr/lib/systemd/system/valkey.service /etc/systemd/system/redis.service
            systemctl daemon-reload
        fi
        for f in /etc/redis/redis.conf /etc/redis.conf /etc/valkey/valkey.conf; do
            [ -f "${f}" ] && REDIS_CONF="${f}" && break
        done
    else
        pkg_install redis-server || return 1
    fi
    return 0
}

redis_enable() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        systemctl enable redis 2>/dev/null || systemctl enable valkey
    else
        systemctl enable redis-server
    fi
}

redis_disable() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        systemctl disable redis 2>/dev/null || systemctl disable valkey
    else
        systemctl disable redis-server
    fi
}

redis_remove() {
    systemctl stop redis 2>/dev/null
    if [ "${OS_FAMILY}" == "rhel" ]; then
        dnf -y remove redis valkey valkey-compat-redis 2>/dev/null
        rm -f /etc/systemd/system/redis.service
    else
        DEBIAN_FRONTEND=noninteractive apt-get purge --auto-remove -y redis-server
    fi
    rm -rf /etc/redis
    systemctl daemon-reload
}

memcached_installed() {
    command -v memcached >/dev/null 2>&1
}

# memcached_install <memory MB> <max connections>
memcached_install() {
    if [ "${OS_FAMILY}" == "rhel" ]; then
        pkg_install memcached || return 1
        cat >"${MEMCACHED_CONF}" <<END
PORT="11211"
USER="memcached"
MAXCONN="${2}"
CACHESIZE="${1}"
OPTIONS="-l 127.0.0.1 -U 0"
END
    else
        pkg_install memcached || return 1
        pkg_install_optional libmemcached-tools
        cat >"${MEMCACHED_CONF}" <<END
# Run memcached as a daemon.
-d
logfile /var/log/memcached.log
# memory
-m ${1}
-p 11211
-u memcache
-l 127.0.0.1
# Limit the number of simultaneous incoming connections
-c ${2}
-P /var/run/memcached/memcached.pid
# Disable UDP
-U 0
END
    fi
    return 0
}

memcached_remove() {
    systemctl stop memcached 2>/dev/null
    pkg_remove memcached
    rm -f /etc/memcached.conf
    systemctl daemon-reload
}

os_detect
