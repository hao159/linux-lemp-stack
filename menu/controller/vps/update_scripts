source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

_set_var(){
    new_v=$(get_version script_version)
    current_v=$(grep -w "script_version" "${FILE_INFO}" | cut -f2 -d'=');
}

_check_update(){
    if [[ -z "${new_v}" ]]; then
        ALERT=$(printf "%s\n" "${RED}Khong kiem tra duoc phien ban moi (${HOMEPAGE_LINK}).${NC}")
    elif [[ "${new_v}" == "${current_v}" ]]; then
        ALERT=$(printf "%s\n" "${RED}Ban dang su dung phien ban moi nhat.${NC}")
    fi
}

_confirm_update(){
    printf "${RED}%s${NC}\n" "Da phat hien phien ban moi."

    while true
    do
        read -r -p "Ban co muon cap nhat ${AUTHOR} Script khong ? (y/n) " prompt_update
        echo
        if [[ "${prompt_update}" =~ ^([yY])$ || "${prompt_update}" =~ ^([nN])$ ]]; then
            break
        else
            clear
            printf "%s\n"  "${RED}Lua chon khong chinh xac. Vui long chon lai.${NC}"
        fi
    done
}

_update(){
    tmp_dir=$(mktemp -d)
    if curl -fsSL "${REPO_TARBALL}" | tar -xz --strip-components=1 -C "${tmp_dir}" && [ -f "${tmp_dir}/menu/hostvn" ]; then
        find "${tmp_dir}"/menu "${tmp_dir}"/version -type f -exec sed -i 's/\r$//' {} +
        rm -rf "${BASH_DIR}"/menu.bak
        mv "${BASH_DIR}"/menu "${BASH_DIR}"/menu.bak
        cp -r "${tmp_dir}"/menu "${BASH_DIR}"/menu
        cp "${tmp_dir}"/version "${BASH_DIR}"/version
        chmod 711 "${BASH_DIR}"/menu
        find "${BASH_DIR}"/menu -type f -exec chmod +x {} +
        cp "${BASH_DIR}"/menu/hostvn /usr/bin/hostvn && chmod +x /usr/bin/hostvn
        sed -i '/script_version=/d' "${FILE_INFO}"
        echo "script_version=${new_v}" >> "${FILE_INFO}"
        rm -rf "${tmp_dir}" "${BASH_DIR}"/menu.bak
        clear
        printf "%s\n" "${GREEN}Update ${AUTHOR} Script thanh cong (${new_v}).${NC}"
        printf "%s\n" "${RED}Script se tu dong thoat menu de ap dung update...${NC}"
    else
        rm -rf "${tmp_dir}"
        printf "%s\n" "${RED}Khong tai duoc ban cap nhat tu ${HOMEPAGE_LINK}.${NC}"
    fi
    sleep 3
    exit
}

_run(){
    _set_var
    _check_update

    if [ -z "${ALERT}" ]; then
        _confirm_update
        if [[ "${prompt_update}" =~ ^([yY])$ ]]; then
            _update
        else
            clear
            printf "%s\n" "${GREEN}Ban da huy update ${AUTHOR} Script${NC}"
        fi

    else
        clear
        printf "%s\n" "${ALERT}"
    fi
}

ALERT=""
prompt_update=""

_run
