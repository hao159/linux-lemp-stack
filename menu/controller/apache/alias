# Parked/Alias domain when Apache is the web server: the alias is a ServerAlias of the website.

source /var/hostvn/menu/validate/rule
source /var/hostvn/menu/helpers/function

printf "%s=====================%s\n" "${GREEN}" "${NC}"
printf "%s Parked/Alias Domain %s\n" "${GREEN}" "${NC}"
printf "%s=====================%s\n" "${GREEN}" "${NC}"

_select_action(){
    PS3="Nhap vao lua chon cua ban [ 1 - 3 ]: "
    select opt_action in "Them Alias Domain" "Xoa Alias Domain" "Cancel"; do
        case $REPLY in
        1) action="add"; break ;;
        2) action="remove"; break ;;
        3) action="cancel"; break ;;
        *) printf "%s\n" "${RED}${WRONG_OPTION}${NC}" ;;
        esac
    done
}

# An alias must not be a website or the alias of another website
_alias_in_use(){
    [ -f "${USER_DIR}/.${1}.conf" ] && return 0
    [ -n "$(ap_redirect_target "$1")" ] && return 0
    grep -qsE "^# hostvn-alias:.*(^| )${1//./\\.}( |\$)" "${VHOST_DIR}"/*.conf
}

_apply(){
    ap_vhost_write "${domain}" "$@"
    if ap_test >/dev/null 2>&1; then
        ap_reload
        return 0
    fi
    return 1
}

_add(){
    local aliases
    read -r -p "Nhap domain Parked/Alias (Khong co www) [0 = Thoat]: " alias_domain
    alias_domain=$(echo "${alias_domain}" | tr '[:upper:]' '[:lower:]')
    alias_domain=${alias_domain//www./}
    if [ -z "${alias_domain}" ] || [ "${alias_domain}" == "0" ]; then
        ALERT=$(printf "%s" "${RED}Huy thao tac.${NC}")
        return
    fi
    if ! echo "${alias_domain}" | grep -q "\." || ! "${BASH_DIR}"/menu/validate/check_value domain "${alias_domain}"; then
        ALERT=$(printf "%s" "${RED}Ten mien ban nhap khong chinh xac.${NC}")
        return
    fi
    if _alias_in_use "${alias_domain}"; then
        ALERT=$(printf "%s" "${RED}Ten mien ${alias_domain} da duoc su dung tren VPS.${NC}")
        return
    fi
    aliases="$(_ap_site_aliases "${domain}") ${alias_domain}"
    # shellcheck disable=SC2086
    if _apply ${aliases}; then
        ALERT=$(printf "%s" "${GREEN}Tao Alias Domain thanh cong. Luu y: chung chi SSL cua ${domain} khong bao gom ${alias_domain}.${NC}")
    else
        ALERT=$(printf "%s" "${RED}${lang_error_vhost}${NC}")
    fi
}

_remove(){
    local aliases alias rest=""
    # shellcheck disable=SC2207
    aliases=($(_ap_site_aliases "${domain}"))
    if [ "${#aliases[@]}" -eq 0 ]; then
        ALERT=$(printf "%s" "${RED}Website ${domain} chua co Alias Domain nao.${NC}")
        return
    fi
    PS3="${INPUT_SELECT} [0 = Thoat]: "
    select opt_alias in "${aliases[@]}"; do
        alias_domain=${opt_alias}
        break
    done
    if [ -z "${alias_domain}" ]; then
        ALERT=$(printf "%s" "${RED}Huy thao tac.${NC}")
        return
    fi
    for alias in "${aliases[@]}"; do
        [ "${alias}" == "${alias_domain}" ] || rest="${rest} ${alias}"
    done
    # the certificate of the alias (menu SSL -> alias domain) goes with it
    rm -rf "${SSL_DIR:?}/${alias_domain}" "/root/.acme.sh/${alias_domain}"
    # shellcheck disable=SC2086
    if _apply ${rest:--}; then
        ALERT=$(printf "%s" "${GREEN}Xoa Parked/Alias thanh cong.${NC}")
    else
        ALERT=$(printf "%s" "${RED}${lang_error_vhost}${NC}")
    fi
}

ALERT=''
action=''
domain=''
alias_domain=''

_select_action
if [ "${action}" == "cancel" ]; then
    ALERT=$(printf "%s" "${RED}Huy thao tac.${NC}")
else
    printf "%s\n" "${RED}Lua chon website chinh.${NC}"
    _select_real_domain
    if [ -z "${ALERT}" ]; then
        if [ -z "${domain}" ]; then
            ALERT=$(printf "%s" "${RED}Huy thao tac.${NC}")
        elif [ "${action}" == "add" ]; then
            _add
        else
            _remove
        fi
    fi
fi

clear
printf "%s\n" "${ALERT}"
menu_domain
