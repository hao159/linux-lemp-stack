source /var/hostvn/menu/helpers/crowdsec

_run(){
    if ! cs_installed; then
        ALERT=$(printf "%s\n" "${RED}Ban chua cai dat CrowdSec.${NC}")
        return
    fi

    read -r -p "Ban co chac chan muon go CrowdSec va AppSec khong ? (y/n) " prompt_uninstall
    if [[ "${prompt_uninstall}" =~ ^([yY])$ ]]; then
        cs_uninstall
        ALERT=$(printf "%s\n" "${GREEN}Go cai dat CrowdSec thanh cong.${NC}")
    else
        ALERT=$(printf "%s\n" "${RED}Huy hanh dong.${NC}")
    fi
}

ALERT=""
prompt_uninstall=""

_run
clear
printf "%s\n" "${ALERT}"
menu_crowdsec
