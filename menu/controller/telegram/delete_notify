source /var/hostvn/menu/helpers/telegram
source /var/hostvn/menu/helpers/crowdsec

_select_notify_action(){
    clear
    printf "%s\n" "Lua chon thao tac ban muon thuc hien"
    PS3="Nhap vao lua chon cua ban [ 1 - 6 ]: "
    options=("Delete Service (Nginx, MariaDB, PHP) Notify" "Delete Disk notify" "Delete SSH notify" "Delete CrowdSec notify" "Xoa toan bo va xoa Token/Chat ID" "Cancel")
    select opt in "${options[@]}"; do
        case $REPLY in
        1) action="service"; break ;;
        2) action="disk"; break ;;
        3) action="ssh"; break ;;
        4) action="crowdsec"; break ;;
        5) action="all"; break ;;
        6) action="cancel"; break ;;
        *) printf "${RED}%s${NC}\n" "Lua chon cua ban khong chinh xac. Vui long chon lai." ;;
        esac
    done
}

_delete_ssh_notify(){
    if tg_ssh_enabled; then
        tg_ssh_disable
        ALERT=$(printf "%s\n" "${GREEN}Xoa cau hinh SSH Notify thanh cong.${NC}")
    else
        ALERT=$(printf "%s\n" "${RED}Ban chua cau hinh SSH Notify.${NC}")
    fi
}

_delete_disk_notify(){
    if tg_disk_enabled; then
        tg_disk_disable
        ALERT=$(printf "%s\n" "${GREEN}Xoa cau hinh Disk Notify thanh cong.${NC}")
    else
        ALERT=$(printf "%s\n" "${RED}Ban chua cau hinh Disk Notify.${NC}")
    fi
}

_delete_service_notify(){
    if tg_service_enabled; then
        tg_service_disable
        ALERT=$(printf "%s\n" "${GREEN}Xoa cau hinh Services Notify thanh cong.${NC}")
    else
        ALERT=$(printf "%s\n" "${RED}Ban chua cau hinh Services Notify.${NC}")
    fi
}

_delete_crowdsec_notify(){
    if cs_telegram_enabled; then
        cs_telegram_disable
        ALERT=$(printf "%s\n" "${GREEN}Xoa cau hinh CrowdSec Notify thanh cong.${NC}")
    else
        ALERT=$(printf "%s\n" "${RED}Ban chua cau hinh CrowdSec Notify.${NC}")
    fi
}

_delete_all(){
    tg_ssh_disable
    tg_disk_disable
    tg_service_disable
    cs_telegram_enabled && cs_telegram_disable
    rm -f "${TG_CONF}"
    ALERT=$(printf "%s\n" "${GREEN}Da xoa toan bo cau hinh Telegram.${NC}")
}

_run(){
    case ${action} in
    service) _delete_service_notify ;;
    disk) _delete_disk_notify ;;
    ssh) _delete_ssh_notify ;;
    crowdsec) _delete_crowdsec_notify ;;
    all) _delete_all ;;
    *) ALERT=$(printf "%s\n" "${RED}Huy hanh dong.${NC}") ;;
    esac

    clear
    printf "%s\n" "$ALERT"
}

ALERT=""
action=""
_select_notify_action
_run
telegram_notify
