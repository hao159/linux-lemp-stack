source /var/hostvn/menu/helpers/telegram

_run(){
    if tg_disk_enabled; then
        ALERT=$(printf "%s" "${RED}Ban da tao Disk Notify roi.${NC}")
    elif ! tg_require; then
        ALERT=$(printf "%s" "${RED}Ban chua cau hinh Telegram.${NC}")
    else
        tg_disk_enable
        ALERT=$(printf "%s" "${GREEN}Tao Disk Notify thanh cong.${NC}")
    fi
}

ALERT=''

_run
clear
printf "%s\n" "${ALERT}"
telegram_notify
